{
  "name": "danshi",
  "main": "expo-router/entry",
  "version": "0.5.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "api:sync": "node ./scripts/sync-openapi.mjs",
    "api:generate": "openapi-typescript openapi.json -o src/generated/openapi.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- openapi.json src/generated/openapi.ts",
    "export:web": "expo export --platform web",
    "eas:login": "npx --yes eas-cli login",
    "eas:init": "npx --yes eas-cli init",
    "build:apk": "npx --yes eas-cli build -p android --profile preview",
    "build:aab": "npx --yes eas-cli build -p android --profile production",
    "build:ios:adhoc": "npx --yes eas-cli build -p ios --profile preview",
    "build:ios:testflight": "npx --yes eas-cli build -p ios --profile testflight",
    "submit:ios:testflight": "npx --yes eas-cli submit -p ios --profile testflight",
    "build:submit:ios:testflight": "npx --yes eas-cli build -p ios --profile testflight --auto-submit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@material/material-color-utilities": "^0.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "^2.3.2",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.17",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "reanimated-color-picker": "^4.2.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@types/spark-md5": "^3.0.5",
    "baseline-browser-mapping": "^2.9.18",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
